{
  "name": "@pattern-dump-demo/styleguide",
  "version": "0.0.0",
  "private": true,
  "description": "Style guide for the Pattern Dump demo site: patterns, skin and styles, packaged as a pattern package.",
  "type": "module",
  "files": [
    "patterns",
    "styles",
    "data",
    "scripts",
    "media"
  ],
  "patternDump": {
    "patterns": "patterns",
    "styles": {
      "dir": "styles",
      "documentBase": [
        "base"
      ]
    },
    "data": "data",
    "scripts": "scripts",
    "assets": [
      "media/images"
    ]
  },
  "scripts": {
    "dev": "pd dev --port 4300",
    "build": "pd build"
  },
  "devDependencies": {
    "pattern-dump": "0.3.0"
  }
}
