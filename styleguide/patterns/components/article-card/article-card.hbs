<article class="article-card">
  <h2 class="article-card-title"><a class="article-card-link" href="{{route}}">{{title}}</a></h2>
  {{#if date}}<p class="article-card-date t-kicker"><time datetime="{{date}}">{{date}}</time></p>{{/if}}
  {{#if description}}<p class="article-card-teaser">{{description}}</p>{{/if}}
  {{#if tags.length}}<ul class="article-card-tags" aria-label="Tags">{{#each tags}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
</article>
