{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Site footer",
  "description": "The site's footer: what it is built with, who made it, and the style guide it comes from.",
  "type": "object",
  "required": [
    "site"
  ],
  "properties": {
    "site": {
      "type": "object",
      "description": "Values every page shares: storefront.site in the site's config",
      "properties": {
        "footer": {
          "type": "object",
          "properties": {
            "project": {
              "type": "object",
              "description": "The project the site is built with",
              "required": [
                "title",
                "href"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "href": {
                  "type": "string",
                  "description": "Its repository"
                }
              }
            },
            "author": {
              "type": "object",
              "description": "Who made the site",
              "required": [
                "name",
                "href"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "href": {
                  "type": "string",
                  "description": "Their profile"
                }
              }
            },
            "styleguide": {
              "type": "object",
              "description": "The design system the site is built from, linking to its workbench",
              "required": [
                "title",
                "href"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "href": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
