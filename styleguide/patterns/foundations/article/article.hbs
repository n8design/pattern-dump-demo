<article class="t-measure">
  <p class="t-kicker">{{kicker}}</p>
  <h1>{{headline}}</h1>
  <p class="t-standfirst">{{standfirst}}</p>
  <p class="t-byline">{{byline}}</p>
  {{#each before}}<p>{{this}}</p>{{/each}}
  <h2>{{subhead}}</h2>
  {{#each after}}<p>{{this}}</p>{{/each}}
  <p class="t-pullquote">{{pullquote}}</p>
  <h3>{{minorhead}}</h3>
  <p>{{closing}}</p>
  <p class="t-fineprint">{{fineprint}}</p>
</article>
