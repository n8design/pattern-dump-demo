<div class="code-specimen t-measure">
  <p>{{before}} <code>{{inline}}</code> {{after}}</p>
  <p>{{keysLabel}} <kbd>{{key}}</kbd>.</p>
  <pre><code>{{block}}</code></pre>
  <p class="code-specimen-label">{{backdropLabel}}</p>
  <div class="code-specimen-backdrop">
    <pre><code>{{block}}</code></pre>
  </div>
</div>
