<div class="site{{#if frame}} site--{{frame}}{{/if}}">
  <header class="site-header">
    <a class="site-title" href="/">{{site.title}}</a>
    <nav class="site-nav" aria-label="Site">
      <ul>
        {{#each nav}}<li><a href="{{route}}"{{#if current}} aria-current="page"{{/if}}>{{title}}</a></li>{{/each}}
      </ul>
    </nav>
  </header>
  {{!-- On one line: an indented, standalone partial include indents every line of its output, <pre> included. --}}
  <main class="site-main" id="main">{{> @partial-block }}</main>
</div>
